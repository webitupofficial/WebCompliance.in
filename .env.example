# ====================================================================
# WebCompliance.in Environment Variables Example
# Provide real values in .env.local (local development) and in hosting dashboard.
# Do NOT commit .env.local or secret keys to version control.
# ====================================================================

# Formspree Form ID (enquiry forms and order alerts)
NEXT_PUBLIC_FORMSPREE_ID=

# Website Privacy Check Pricing (in INR)
# CHECK_PRICE_INR is read strictly on the server
CHECK_PRICE_INR=
NEXT_PUBLIC_CHECK_PRICE_INR=
NEXT_PUBLIC_PRICE_INCLUDES_GST=

# Secret key used to sign single-use, 24-hour scan access tokens (HMAC-SHA256)
SCAN_TOKEN_SECRET=

# Razorpay Payment Gateway (Test Mode Only)
# Browser receives only NEXT_PUBLIC_RAZORPAY_KEY_ID
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Transactional Email Provider (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public App Base URL (optional, defaults to request origin)
NEXT_PUBLIC_APP_URL=
